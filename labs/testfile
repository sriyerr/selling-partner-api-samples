import json

def lambda_handler(event, context):
    # Make event always a dict
    if event is None:
        event = {}

    # Body might be:
    # - a JSON string
    # - already a dict
    # - None
    body = event.get("body", {})
    if isinstance(body, str):
        try:
            body = json.loads(body)
        except:
            body = {}

    user_message = body.get("message", "Hello from B2B agent")

    return {
        "statusCode": 200,
        "headers": {"Content-Type": "application/json"},
        "body": json.dumps({
            "echo": user_message,
            "info": "b2b-pricing-agent lambda is wired and ready"
        })
    }

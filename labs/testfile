version: 0.2

phases:
  pre_build:
    commands:
      - echo Logging in to Amazon ECR...
      - aws --version

      # extract registry hostname (everything before first "/")
      - REPOSITORY_REGISTRY=$(echo $REPOSITORY_URI | cut -d'/' -f1)
      - echo "Using registry: $REPOSITORY_REGISTRY"

      # login to registry
      - aws ecr get-login-password --region $AWS_DEFAULT_REGION | docker login --username AWS --password-stdin $REPOSITORY_REGISTRY

  build:
    commands:
      - echo Build started on `date`
      - echo Navigating to SP-API MCP sample...
      - cd use-cases/sp-api-mcp-server

      - echo Creating Dockerfile...
      - |
        cat << 'EOF' > Dockerfile
        FROM node:20-alpine
        WORKDIR /app
        COPY package*.json ./
        RUN npm install --only=production
        COPY . .
        CMD ["npm", "start"]
        EOF

      - echo Building Docker image...
      - docker build -t $REPOSITORY_URI:latest .

  post_build:
    commands:
      - echo Pushing Docker image to ECR...
      - docker push $REPOSITORY_URI:latest
      - echo Build completed on `date`

artifacts:
  files:
    - '**/*'

// index.mjs - MCP proxy Lambda handler (Node.js 20, ES module)

import path from "path";
import { fileURLToPath } from "url";

import { Client } from "@modelcontextprotocol/sdk/client/index.js";
import { StdioClientTransport } from "@modelcontextprotocol/sdk/client/stdio.js";
import {
  ListToolsResultSchema,
  CallToolResultSchema,
} from "@modelcontextprotocol/sdk/types.js";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

function parseBody(event) {
  if (!event || !event.body) return {};
  try {
    if (typeof event.body === "string") {
      return JSON.parse(event.body);
    }
    return event.body;
  } catch {
    return {};
  }
}

export const handler = async (event) => {
  const body = parseBody(event);
  const toolName = body.toolName || "";   // empty = just list tools
  const toolArgs = body.arguments || {};

  // Directory where the vendored Amazon SP-API MCP server lives
  const serverDir = path.join(__dirname, "sp-api-mcp-server");

  // Let StdioClientTransport spawn the MCP server as a child process.
  // This avoids the ERR_INVALID_ARG_TYPE from normalizeSpawnArguments.
  const transport = new StdioClientTransport({
    command: "node",
    args: ["build/index.js"],
    cwd: serverDir,
    env: {
      ...process.env,   // includes SP_API_* and CATALOG_PATH set in Lambda
    },
  });

  const client = new Client(
    { name: "sp-api-mcp-proxy", version: "1.0.0" },
    { capabilities: { tools: {} } }
  );

  try {
    // Connect MCP client over stdio to the spawned MCP server
    await client.connect(transport);

    // 1) Always list tools to prove MCP wiring is working
    const toolsResult = await client.request(
      { method: "tools/list" },
      ListToolsResultSchema
    );

    let toolCallResult = null;

    // 2) If caller specifies a toolName, call that tool as well
    if (toolName) {
      toolCallResult = await client.request(
        {
          method: "tools/call",
          params: {
            name: toolName,
            arguments: toolArgs,
          },
        },
        CallToolResultSchema
      );
    }

    // Cleanly close MCP client + transport
    await client.close();

    return {
      statusCode: 200,
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(
        {
          message: "MCP proxy call successful",
          tools: toolsResult,
          toolCall: toolCallResult,
        },
        null,
        2
      ),
    };
  } catch (err) {
    console.error("MCP proxy error:", err);
    try {
      await client.close();
    } catch (_) {
      // ignore
    }
    return {
      statusCode: 500,
      body: JSON.stringify({
        error: "MCP proxy failed",
        details: err?.message || String(err),
      }),
    };
  }
};

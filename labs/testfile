// index.mjs - MCP proxy Lambda handler (Node.js 20, ES module)

import { spawn } from "child_process";
import path from "path";
import { fileURLToPath } from "url";

import { Client } from "@modelcontextprotocol/sdk/client";
import { StdioClientTransport } from "@modelcontextprotocol/sdk/client/stdio";
import {
  ListToolsResultSchema,
  CallToolResultSchema,
} from "@modelcontextprotocol/sdk/types";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

function parseBody(event) {
  if (!event || !event.body) return {};
  try {
    if (typeof event.body === "string") {
      return JSON.parse(event.body);
    }
    return event.body;
  } catch {
    return {};
  }
}

export const handler = async (event) => {
  const body = parseBody(event);
  const toolName = body.toolName || "";   // if empty, we'll just list tools
  const toolArgs = body.arguments || {};

  // Where the vendored MCP server lives inside the Lambda package
  const serverDir = path.join(__dirname, "sp-api-mcp-server");

  // Spawn the Amazon SP-API MCP server (unchanged code)
  const child = spawn("node", ["build/index.js"], {
    cwd: serverDir,
    env: {
      ...process.env,  // includes SP_API_* and CATALOG_PATH from Lambda env
    },
    stdio: "pipe",
  });

  // Hook up MCP over stdio
  const transport = new StdioClientTransport({
    stdin: child.stdin,
    stdout: child.stdout,
  });

  const client = new Client(
    { name: "sp-api-mcp-proxy", version: "1.0.0" },
    { capabilities: { tools: {} } }
  );

  try {
    await client.connect(transport);

    // 1) List tools from the MCP server
    const toolsResult = await client.request(
      { method: "tools/list" },
      ListToolsResultSchema
    );

    let toolCallResult = null;

    // 2) Optionally call a tool if toolName provided
    if (toolName) {
      toolCallResult = await client.request(
        {
          method: "tools/call",
          params: {
            name: toolName,
            arguments: toolArgs,
          },
        },
        CallToolResultSchema
      );
    }

    await client.close();
    child.kill();

    return {
      statusCode: 200,
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(
        {
          message: "MCP proxy call successful",
          tools: toolsResult,
          toolCall: toolCallResult,
        },
        null,
        2
      ),
    };
  } catch (err) {
    console.error("MCP proxy error:", err);
    try { child.kill(); } catch {}
    return {
      statusCode: 500,
      body: JSON.stringify({
        error: "MCP proxy failed",
        details: err?.message || String(err),
      }),
    };
  }
};

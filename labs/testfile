version: 0.2
phases:
  pre_build:
    commands:
      - echo Logging in to Amazon ECR...
      - aws --version
      - aws ecr get-login-password --region $AWS_DEFAULT_REGION | docker login --username AWS --password-stdin $REPOSITORY_REGISTRY

  build:
    commands:
      - echo Build started on `date`
      - cd use-cases/sp-api-mcp-server
      
      # 1. Install ALL dependencies for the CodeBuild environment
      - npm install
      
      # 2. CRITICAL FIX: Compile TypeScript to JavaScript
      - echo "Compiling TypeScript to JavaScript..."
      - npm run build
      
      # 3. GENERATE A CLEAN, PRODUCTION-ONLY DOCKERFILE
      - echo "FROM public.ecr.aws/docker/library/node:20-alpine" > Dockerfile
      - echo "WORKDIR /app" >> Dockerfile
      - echo "COPY package*.json ./" >> Dockerfile
      # Install only PRODUCTION dependencies, omitting dev dependencies
      - echo "RUN npm install --omit=dev" >> Dockerfile
      # Copy the pre-compiled JS output directory ('build')
      - echo "COPY build/ ./build/" >> Dockerfile 
      # The CMD runs the compiled index.js file directly with 'node'.
      - echo 'CMD ["node", "build/index.js"]' >> Dockerfile

      - echo Building Docker image...
      - docker build -t $REPOSITORY_URI:latest .

  post_build:
    commands:
      - echo Pushing Docker image to ECR...
      - docker push $REPOSITORY_URI:latest
      - echo Build completed on `date`

artifacts:
  files:
    - '**/*'

version: 0.2
phases:
  pre_build:
    commands:
      - echo Logging in to Amazon ECR...
      - aws --version
      - aws ecr get-login-password --region $AWS_DEFAULT_REGION | docker login --username AWS --password-stdin $REPOSITORY_REGISTRY

  build:
    commands:
      - echo Build started on `date`
      - cd use-cases/sp-api-mcp-server
      
      # 1. Capture the current absolute path for logging (using lowercase 'export')
      - export APP_PATH=$(pwd)
      
      # 2. Install ALL dependencies and compile the TypeScript
      - npm install
      - echo "Compiling TypeScript to JavaScript..."
      - npm run build
      
      # 🚨 DIAGNOSTIC LOGS: Check the output folder content and location 🚨
      - echo "--- Current Working Directory: $APP_PATH ---"
      - ls -R build
      
      # 3. CRITICAL FIX: GENERATE DOCKERFILE using single quotes for robustness
      # ⚠️ This guarantees the Dockerfile is created.
      - 'echo "FROM public.ecr.aws/docker/library/node:20-alpine" > Dockerfile'
      - 'echo "WORKDIR /app" >> Dockerfile'
      - 'echo "COPY package*.json ./" >> Dockerfile'
      - 'echo "RUN npm install --omit=dev" >> Dockerfile'
      - 'echo "COPY build/ /app" >> Dockerfile'
      - 'echo "CMD ["node", "index.js"]" >> Dockerfile'
      
      # 4. Final check before docker build
      - echo "--- Files in the CodeBuild context (Dockerfile MUST be listed): ---"
      - **ls -a** - echo Building Docker image...
      - docker build -t $REPOSITORY_URI:latest .

  post_build:
    commands:
      - echo Pushing Docker image to ECR...
      - docker push $REPOSITORY_URI:latest
      - echo Build completed on `date`

artifacts:
  files:
    - '**/*'
